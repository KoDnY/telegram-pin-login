# Copy to bot/.env and fill locally. Never commit real secrets.
PORT=8080
API_BASE_URL=http://127.0.0.1:3000
BOT_TOKEN=
ADMIN_CHAT_ID=
# Must match the API INTERNAL_API_KEY; use a long random value.
INTERNAL_API_KEY=
# Separate random secret: only A-Z, a-z, 0-9, underscore and hyphen.
WEBHOOK_SECRET=
# HTTPS forwarding address shown by: ngrok http 8080 (no trailing slash).
PUBLIC_BASE_URL=
